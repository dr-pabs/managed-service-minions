  "dependencies": {
    "framework-core": "workspace:*",
    "mcp-toolshed": "workspace:*",
    "orchestrator": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.8.3"
  }
