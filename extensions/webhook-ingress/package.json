{
  "name": "webhook-ingress",
  "version": "0.1.0",
  "type": "module",
  "description": "GitHub/Azure DevOps webhook ingress for the Minions Agent Framework (Milestone 15, F11): verifies webhook signatures and drives the same orchestrator runner chat mentions use.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
