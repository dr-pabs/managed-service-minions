{
  "name": "queue-ingress",
  "version": "0.1.0",
  "type": "module",
  "description": "Service Bus work-item queue ingress for the Minions Agent Framework (Milestone 15): consumes typed WorkItem envelopes with redelivery-safe idempotency and dead-lettering, driving the same orchestrator runner chat and webhook ingresses use.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./escalation.js": "./dist/escalation.js",
    "./item-pipeline.js": "./dist/item-pipeline.js",
    "./pipeline-config.js": "./dist/pipeline-config.js",
    "./work-item.js": "./dist/work-item.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:soak": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.soak.config.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "framework-core": "workspace:*",
    "js-yaml": "^4.1.0",
    "mcp-toolshed": "workspace:*",
    "orchestrator": "workspace:*",
    "@azure/data-tables": "^13.3.0",
    "@azure/service-bus": "^7.9.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.8.3"
  }
}
